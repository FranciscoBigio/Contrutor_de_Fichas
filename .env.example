# ==========================================
# Variáveis de Ambiente - Exemplo (.env.example)
# ==========================================
# Copie este arquivo para .env ou .env.local e preencha os valores reais:
# cp .env.example .env
#
# NOTA: No Expo/React Native, apenas variáveis com o prefixo EXPO_PUBLIC_
# são expostas para o código do cliente (JavaScript/TypeScript).
# Variáveis sem o prefixo EXPO_PUBLIC_ ficam disponíveis apenas em scripts de build.

# URL base da API (se aplicável)
EXPO_PUBLIC_API_URL=https://api.exemplo.com/v1

# Chaves de serviços públicos (Analytics, etc.)
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_ANALYTICS_KEY=

# EAS / Build Configs (uso interno)
# EXPO_APPLE_APP_SPECIFIC_PASSWORD=

